# Reasoning-model / OpenAI agent (and LLM router). Required for live full runs.
AGENT_API_KEY=

# Jev via the official TypeSafe System One API. Required for live Jev runs.
TYPESAFE_API_KEY=

# Optional: Jev or other models via OpenRouter (not the M1/M2 pin path).
OPENROUTER_API_KEY=

# Optional Memora mirror. The benchmark runs without these.
MEMORA_API_KEY=
MEMORA_AGENT_ID=
